# =============================================================
# Configuración pública del frontend (Supabase)
# Copia este archivo a .env y rellena los valores.
#
# IMPORTANTE: NUNCA pongas la service_role key aquí.
# Solo la anon key, que está diseñada para ser pública (la
# seguridad real la aplica Row Level Security en la base de datos).
# =============================================================

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
